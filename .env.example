# Neo4j
CRTKB_NEO4J_URI=bolt://localhost:7687
CRTKB_NEO4J_USER=neo4j
CRTKB_NEO4J_PASSWORD=changeme
CRTKB_NEO4J_DATABASE=neo4j

# vLLM
CRTKB_VLLM_BASE_URL=http://localhost:8000/v1
CRTKB_VLLM_MODEL_NAME=Qwen/Qwen2.5-72B-Instruct
CRTKB_VLLM_API_KEY=not-needed

# Embeddings
CRTKB_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
CRTKB_EMBEDDING_DIMENSIONS=1024

# Entity Resolution
CRTKB_ER_EMBEDDING_THRESHOLD=0.88
CRTKB_ER_BORDERLINE_LOW=0.80

# Pipeline
CRTKB_CHUNK_SIZE=1500
CRTKB_CHUNK_OVERLAP=200
CRTKB_MERGE_BATCH_SIZE=500
CRTKB_QUALITY_CONFIDENCE_THRESHOLD=0.5

# Langfuse
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000

# Docker Compose overrides
MODEL_PATH=./models
VLLM_TP=2
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
LANGFUSE_SECRET=changeme
