# Neo4j
COGRAPH_NEO4J_URI=bolt://localhost:7687
COGRAPH_NEO4J_USER=neo4j
COGRAPH_NEO4J_PASSWORD=changeme
COGRAPH_NEO4J_DATABASE=neo4j

# LLM — choose provider: "google", "openai", or "vllm"
COGRAPH_LLM_PROVIDER=google
COGRAPH_LLM_MODEL_NAME=gemini-2.5-flash
COGRAPH_LLM_API_KEY=your-google-api-key-here
COGRAPH_LLM_BASE_URL=

# Embeddings
COGRAPH_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
COGRAPH_EMBEDDING_DIMENSIONS=1024

# Entity Resolution
COGRAPH_ER_EMBEDDING_THRESHOLD=0.88
COGRAPH_ER_BORDERLINE_LOW=0.80

# Pipeline
COGRAPH_CHUNK_SIZE=1500
COGRAPH_CHUNK_OVERLAP=200
COGRAPH_MERGE_BATCH_SIZE=500
COGRAPH_QUALITY_CONFIDENCE_THRESHOLD=0.5

# Langfuse (optional)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000

# Docker Compose overrides
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
